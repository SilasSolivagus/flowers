# /opt/flowers/.env.production —— 生产环境变量（权限 600，root 持有）
#
# 这份文件里**没有** wecom / 生成器 / 群机器人的凭据：
# - wecom-cli 的授权在 /root/.config/wecom（扫码得到，不进文件）
# - 群机器人 webhook 存在库里的 app_settings（notify.groupWebhook），换群不用改这里
# - 模型 key 存在库里的 provider.*（设置页填），也不在这里
#
# 这也意味着：**备份库 = 备份了这些配置**。改密码/换 key 都在库里。

# ── 必填 ────────────────────────────────────────────────────────────────────
# 连库串。生产用独立角色，不给 postgres 超级用户。
DATABASE_URL=postgres://flowers_app:REPLACE_ME@127.0.0.1:5432/flowers

# 会话签名密钥。**固定值**，丢了所有人掉线。生成：openssl rand -base64 48
FLOWERS_SESSION_SECRET=REPLACE_ME

# 对外地址：群播报/卡片里的链接用它拼。必须带 https，且不带尾斜杠。
FLOWERS_PUBLIC_URL=https://flower.dirctable.com

# 运行时数据目录（会话密钥 + UEmaster 产物 HTML）。**必须在仓库外**。
# 仓库里的任何 git 命令都碰不到它；`git clean -fdx` 删不掉别人的评审材料。
FLOWERS_DATA_DIR=/var/lib/flowers

TZ=Asia/Shanghai
NODE_ENV=production

# ── 可选 ────────────────────────────────────────────────────────────────────
# wecom-cli 的路径（默认就是 PATH 上的 wecom-cli；装在 /usr/bin，通常不用写）
# FLOWERS_WECOM_CLI=/usr/bin/wecom-cli

# 汇总表换表时才用（默认值写死在 src/core/sheet/queue-sheet.ts）
# FLOWERS_QUEUE_SHEET_DOC=https://doc.weixin.qq.com/sheet/e3_…
# FLOWERS_QUEUE_SHEET_TAB=kvf2dh

# 群机器人（库里有值时以库为准；两个都没配就只发站内）
# FLOWERS_GROUP_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=…

# 生成器命令（库里有 generator.command 时以库为准）
# FLOWERS_GEN_CMD=
