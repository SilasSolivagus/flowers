{
  "name": "flowers",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:test:setup": "tsx scripts/db-test-setup.ts",
    "db:anchor": "tsx scripts/migrate-line-anchor.ts",
    "db:brief": "tsx scripts/migrate-brief-to-inbox.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "design:check": "node scripts/check-design-tokens.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "typecheck": "tsc --noEmit",
    "dev": "next dev -p 3000 --webpack",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "mcp": "node dist/mcp/server.js",
    "mcp:build": "tsc -p tsconfig.mcp.json",
    "seed": "tsx scripts/seed.ts",
    "migrate:flower": "tsx scripts/migrate-flower.ts",
    "prd:backfill": "tsx scripts/prd-backfill.ts --apply",
    "prd:backfill:emit": "tsx scripts/prd-backfill.ts --emit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.36.0",
    "next": "^16.4.5",
    "pg": "^8.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
