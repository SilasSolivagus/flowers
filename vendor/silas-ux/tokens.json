{
  "meta": {
    "name": "silas-UX 设计变量",
    "version": "1.2.0",
    "date": "2026-11-04",
    "source": "由 roxorlt/ui-design 的 rQuant v1.3.1 与门店通 v1.0 提炼，统一命名",
    "rule": "命名 类别-角色-变体；默认浅色，深色为配套组；对比度不低于 4.5:1",
    "note": "v1.2 补布局断点：三栏并排/堆叠的临界值"
  },
  "color": {
    "light": {
      "bg": {
        "value": "#F3F5F7",
        "use": "页面底"
      },
      "surface": {
        "value": "#FFFFFF",
        "use": "卡片、面板、表格容器"
      },
      "surface-2": {
        "value": "#F8F9FA",
        "use": "次级块、悬停行"
      },
      "sunken": {
        "value": "#ECEFF2",
        "use": "凹陷区、分段控件底"
      },
      "line": {
        "value": "#E3E7EC",
        "use": "分隔线"
      },
      "line-strong": {
        "value": "#CCD3DB",
        "use": "输入框描边、卡片描边"
      },
      "text-1": {
        "value": "#161A21",
        "use": "正文、标题"
      },
      "text-2": {
        "value": "#3A4250",
        "use": "次级信息"
      },
      "text-3": {
        "value": "#5E6776",
        "use": "标签、单位"
      },
      "text-4": {
        "value": "#8A92A0",
        "use": "占位、禁用"
      },
      "accent": {
        "value": "#2448D0",
        "use": "主色、选中态"
      },
      "accent-weak": {
        "value": "#EAEFFC",
        "use": "主色浅底"
      },
      "on-accent": {
        "value": "#FFFFFF",
        "use": "主色上的文字"
      },
      "positive": {
        "value": "#07773F",
        "use": "成功、通过"
      },
      "positive-weak": {
        "value": "#E3F3EA",
        "use": "成功浅底"
      },
      "negative": {
        "value": "#B4232B",
        "use": "错误、阻塞"
      },
      "negative-weak": {
        "value": "#FCECEC",
        "use": "错误浅底"
      },
      "warning": {
        "value": "#8F5B00",
        "use": "警告、待确认"
      },
      "warning-weak": {
        "value": "#FBF1DC",
        "use": "警告浅底"
      },
      "info": {
        "value": "#2448D0",
        "use": "信息、提示"
      },
      "scrim": {
        "value": "rgba(22,26,33,0.40)",
        "use": "遮罩"
      }
    },
    "dark": {
      "bg": {
        "value": "#000000"
      },
      "surface": {
        "value": "#141416"
      },
      "surface-2": {
        "value": "#1F1F23"
      },
      "sunken": {
        "value": "#2A2A2F"
      },
      "line": {
        "value": "#2C2C31"
      },
      "line-strong": {
        "value": "#3A3A41"
      },
      "text-1": {
        "value": "#F2F2F4"
      },
      "text-2": {
        "value": "#A1A1AA"
      },
      "text-3": {
        "value": "#8B8B95"
      },
      "text-4": {
        "value": "#6E6E78"
      },
      "accent": {
        "value": "#F5A524"
      },
      "accent-weak": {
        "value": "rgba(245,165,36,.14)"
      },
      "on-accent": {
        "value": "#000000"
      },
      "positive": {
        "value": "#3DD68C"
      },
      "negative": {
        "value": "#FF6369"
      },
      "warning": {
        "value": "#F5A524"
      },
      "info": {
        "value": "#5AA9FF"
      }
    }
  },
  "type": {
    "family": "PingFang SC, HarmonyOS Sans SC, Hiragino Sans GB, Microsoft YaHei, Noto Sans SC, system-ui, sans-serif",
    "family-num": "SF Pro Text, -apple-system, system-ui, sans-serif",
    "family-mono": "SF Mono, JetBrains Mono, Menlo, Consolas, monospace",
    "scale": {
      "display": {
        "size": 32,
        "line": 38,
        "weight": 600
      },
      "title-1": {
        "size": 20,
        "line": 28,
        "weight": 600
      },
      "title-2": {
        "size": 16,
        "line": 24,
        "weight": 600
      },
      "section": {
        "size": 15,
        "line": 22,
        "weight": 600
      },
      "body": {
        "size": 13,
        "line": 20,
        "weight": 400
      },
      "body-s": {
        "size": 12,
        "line": 18,
        "weight": 400
      },
      "caption": {
        "size": 11,
        "line": 16,
        "weight": 400
      }
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48
  },
  "radius": {
    "xs": 4,
    "sm": 6,
    "md": 10,
    "lg": 14,
    "pill": 999
  },
  "shadow": {
    "none": "none",
    "overlay": "0 8px 24px rgba(22,26,33,0.12)",
    "note": "阴影只用于浮层，卡片一律靠描边分层"
  },
  "motion": {
    "duration-fast": 120,
    "duration-base": 200,
    "duration-slow": 320,
    "easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "rule": "超过 320ms 的动效一律砍掉；列表滚动不加动效"
  },
  "size": {
    "control-h": 32,
    "control-h-phone": 44,
    "row-h": 40,
    "row-h-dense": 32,
    "topbar-h": 56,
    "nav-h-phone": 44,
    "status-h-phone": 24,
    "btn-h-phone": 44,
    "device-phone-min-h": 680,
    "table-head-h": 32
  },
  "breakpoint": {
    "phone": 768,
    "tablet": 1024,
    "three-col-phone": 1271,
    "three-col-wide": 1586,
    "laptop": 1440,
    "desktop": 1920,
    "note": "三栏布局（流程图 520 + 手机框 375 / 后台框 690 + 标注 300 + 间距 76）在 1271 以上并排，以下堆叠；后台页需 1586"
  }
}